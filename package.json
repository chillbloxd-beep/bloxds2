{
  "name": "oneblock-analytics",
  "private": true,
  "version": "0.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "typecheck:extension": "tsc --noEmit -p tsconfig.extension.json",
    "build": "npm run typecheck && vite build",
    "build:extension": "npm run typecheck:extension && vite build --config vite.extension.config.mjs",
    "audit:extension": "node scripts/audit-extension.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply oneblock-analytics --local",
    "db:migrate:remote": "wrangler d1 migrations apply oneblock-analytics --remote"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.130.0"
  }
}
